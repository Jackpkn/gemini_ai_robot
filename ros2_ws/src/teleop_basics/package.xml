<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- Package name used by colcon and ros2 run commands -->
  <name>teleop_basics</name>
  <version>0.1.0</version>
  <description>Phase 1 foundational ROS 2 Python Pub/Sub package with heartbeat telemetry and latency helpers.</description>
  <maintainer email="pawankumarbairwa879@gmail.com">Jackpkn</maintainer>
  <license>MIT</license>

  <!-- Runtime dependencies resolved by ROS 2 / rosdep -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <!-- Tells colcon this is a pure-Python ROS 2 package (uses setup.py instead of CMake) -->
    <build_type>ament_python</build_type>
  </export>
</package>
